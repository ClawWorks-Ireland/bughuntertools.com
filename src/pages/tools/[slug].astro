---
/**
 * [slug].astro — Dynamic route for SecurityClaw Tools Database.
 * Generates one page per tool in src/_data/tools.json.
 * Each page: unique title, meta description, single h1, affiliate links tag=bughuntertools-20.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import toolsData from '../../_data/tools.json';

export function getStaticPaths() {
  return toolsData.tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;

const title = `${tool.name} — Bug Bounty Security Tool Review 2026 | Bug Hunter Tools`;
const description = `${tool.description} Learn how SecurityClaw uses ${tool.name} for autonomous bug bounty campaigns, key features, and recommended resources.`;

const categoryLabels: Record<string, string> = {
  'recon': 'Reconnaissance & OSINT',
  'web-testing': 'Web Application Testing',
  'api-security': 'API Security',
  'network-recon': 'Network Reconnaissance',
  'cloud': 'Cloud Security',
  'mobile': 'Mobile Security',
  'exploitation': 'Exploitation',
  'enumeration': 'Enumeration',
  'scanning': 'Scanning',
  'secrets-detection': 'Secrets Detection',
  'osint': 'OSINT',
  'platform': 'Platform / Automation',
  'web-scanning': 'Web Scanning',
};

const categoryLabel = categoryLabels[tool.category] || tool.category;

const scorecardCategoryLabels: Record<string, string> = {
  'web-vuln-scanning': 'Web Vulnerability Scanning',
  'secrets-detection': 'Secrets Detection',
  'network-recon': 'Network Reconnaissance',
  'cloud-misconfiguration': 'Cloud Misconfiguration',
  'api-security': 'API Security',
};
const scorecardLabel = scorecardCategoryLabels[tool.scorecard_category] || tool.scorecard_category;

const kindLabel = tool.kind === 'skill' ? 'SecurityClaw Skill' : tool.kind === 'external' ? 'External Tool' : 'Integrated Tool';

const amazonSearchUrl = `https://www.amazon.com/s?k=${encodeURIComponent(tool.amazon_query)}&tag=bughuntertools-20`;

const relatedTools = toolsData.tools
  .filter((t) => t.slug !== tool.slug && (t.category === tool.category || t.scorecard_category === tool.scorecard_category))
  .slice(0, 4);
---

<BaseLayout title={title} description={description}>
  <article style="max-width: 860px; margin: 0 auto; padding: 2rem 1.5rem; font-family: system-ui, sans-serif; line-height: 1.7; color: #1a1a2e;">

    <nav style="margin-bottom: 1.5rem; font-size: 0.875rem; color: #666;">
      <a href="/" style="color: #667eea; text-decoration: none;">Bug Hunter Tools</a>
      <span style="margin: 0 0.5rem;">›</span>
      <a href="/tools/" style="color: #667eea; text-decoration: none;">Tools Database</a>
      <span style="margin: 0 0.5rem;">›</span>
      <span>{tool.name}</span>
    </nav>

    <header style="margin-bottom: 2rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
        <span style="background: #667eea; color: white; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.8rem; font-weight: 600;">{kindLabel}</span>
        <span style="background: #f0f0f8; color: #444; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.8rem;">{categoryLabel}</span>
        <span style="background: #fff3e0; color: #e65100; padding: 0.25rem 0.75rem; border-radius: 20px; font-size: 0.8rem;">SecurityClaw: {scorecardLabel}</span>
      </div>
      <h1 style="font-size: 2rem; font-weight: 800; margin: 0 0 0.5rem; color: #1a1a2e;">{tool.name}</h1>
      {tool.vendor && (
        <p style="color: #666; margin: 0 0 1rem;">by <strong>{tool.vendor}</strong></p>
      )}
      <p style="font-size: 1.125rem; color: #444; margin: 0;">{tool.description}</p>
    </header>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.375rem; font-weight: 700; color: #1a1a2e; border-bottom: 2px solid #667eea; padding-bottom: 0.5rem; margin-bottom: 1rem;">Primary Use Cases</h2>
      <p style="color: #444; margin: 0;">{tool.use_case}</p>
    </section>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.375rem; font-weight: 700; color: #1a1a2e; border-bottom: 2px solid #667eea; padding-bottom: 0.5rem; margin-bottom: 1rem;">How SecurityClaw Uses {tool.name}</h2>
      <div style="background: #f7f7ff; border-left: 4px solid #667eea; padding: 1.25rem 1.5rem; border-radius: 0 8px 8px 0;">
        <p style="margin: 0 0 0.75rem;"><strong>SecurityClaw Skill ID:</strong> <code style="background: #e8e8f8; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.9rem;">{tool.skill_id || 'external integration'}</code></p>
        <p style="margin: 0 0 0.75rem;"><strong>Campaign Phase:</strong> {tool.category === 'recon' || tool.category === 'osint' ? 'Reconnaissance (Phase 1)' : tool.category === 'exploitation' ? 'Exploitation (human-approved gate)' : tool.category === 'api-security' ? 'API Security Assessment' : tool.category === 'cloud' ? 'Cloud Misconfiguration Scanning' : 'Active Assessment'}</p>
        <p style="margin: 0;"><strong>Chain Rule:</strong> {
          tool.slug === 'nuclei' ? 'Triggered automatically on SUBDOMAIN_FOUND findings' :
          tool.slug === 'subfinder' || tool.slug === 'certificate-transparency-monitor' ? 'Pre-campaign attack surface mapping' :
          tool.slug === 'waf-detection' ? 'Early campaign — triggers cf-aware-scan-strategy on WAF_DETECTED' :
          tool.slug === 'js-bundle-analyzer' ? 'Triggered on JS_BUNDLE_FOUND — feeds API key validator and internal endpoint discovery' :
          tool.slug === 'ssrf-probe' ? 'Triggered on InternalHostnameLeak findings' :
          tool.slug === 'api-key-validator' ? 'Triggered on CREDENTIAL_FOUND or JS_BUNDLE_FOUND' :
          tool.slug === 'hashcat' ? 'Triggered automatically on CREDENTIAL_FOUND findings' :
          tool.category === 'exploitation' ? 'Requires explicit human approval before execution' :
          'Runs as part of adaptive campaign engine queue'
        }</p>
      </div>
    </section>

    <section style="margin-bottom: 2.5rem;">
      <h2 style="font-size: 1.375rem; font-weight: 700; color: #1a1a2e; border-bottom: 2px solid #667eea; padding-bottom: 0.5rem; margin-bottom: 1rem;">Tags</h2>
      <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
        {tool.tags.map((tag) => (
          <span style="background: #f0f0f8; color: #555; padding: 0.3rem 0.75rem; border-radius: 20px; font-size: 0.85rem;">#{tag}</span>
        ))}
      </div>
    </section>

    {tool.homepage && (
      <section style="margin-bottom: 2.5rem;">
        <h2 style="font-size: 1.375rem; font-weight: 700; color: #1a1a2e; border-bottom: 2px solid #667eea; padding-bottom: 0.5rem; margin-bottom: 1rem;">Official Resource</h2>
        <a
          href={tool.homepage}
          rel="noopener noreferrer"
          target="_blank"
          style="display: inline-flex; align-items: center; gap: 0.5rem; background: #1a1a2e; color: white; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 600;"
        >
          Visit {tool.name} Homepage →
        </a>
      </section>
    )}

    <section style="margin-bottom: 2.5rem; background: #fffbf0; border: 1px solid #ffe082; border-radius: 12px; padding: 1.5rem;">
      <h2 style="font-size: 1.25rem; font-weight: 700; color: #1a1a2e; margin-bottom: 0.5rem;">📚 Recommended Reading</h2>
      <p style="color: #666; margin-bottom: 1rem; font-size: 0.95rem;">Deepen your skills with books and resources on {categoryLabel.toLowerCase()}:</p>
      <a
        href={amazonSearchUrl}
        rel="sponsored nofollow"
        target="_blank"
        style="display: inline-flex; align-items: center; gap: 0.5rem; background: #ff9900; color: white; padding: 0.75rem 1.5rem; border-radius: 8px; text-decoration: none; font-weight: 600;"
      >
        🛒 Browse {tool.name} Books on Amazon →
      </a>
      <p style="color: #888; font-size: 0.8rem; margin-top: 0.75rem; margin-bottom: 0;">
        <em>Affiliate link — we earn a small commission at no extra cost to you. Supports bughuntertools.com.</em>
      </p>
    </section>

    {relatedTools.length > 0 && (
      <section style="margin-bottom: 2.5rem;">
        <h2 style="font-size: 1.375rem; font-weight: 700; color: #1a1a2e; border-bottom: 2px solid #667eea; padding-bottom: 0.5rem; margin-bottom: 1rem;">Related Tools in SecurityClaw</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1rem;">
          {relatedTools.map((related) => (
            <a
              href={`/tools/${related.slug}/`}
              style="display: block; background: #f7f7ff; border: 1px solid #e0e0f0; border-radius: 8px; padding: 1rem; text-decoration: none; color: inherit; transition: border-color 0.2s;"
            >
              <div style="font-weight: 700; color: #1a1a2e; margin-bottom: 0.25rem;">{related.name}</div>
              <div style="font-size: 0.8rem; color: #888;">{categoryLabels[related.category] || related.category}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <footer style="border-top: 1px solid #e0e0f0; padding-top: 1.5rem; color: #888; font-size: 0.875rem;">
      <p>
        <a href="/tools/" style="color: #667eea; text-decoration: none;">← Back to Tools Database</a>
        {' · '}
        <a href="/securityclaw/" style="color: #667eea; text-decoration: none;">SecurityClaw Platform Overview</a>
        {' · '}
        <a href="/articles/" style="color: #667eea; text-decoration: none;">Security Articles</a>
      </p>
    </footer>
  </article>
</BaseLayout>
