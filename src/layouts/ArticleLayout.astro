---
/**
 * ArticleLayout.astro
 * Shared layout for all bughuntertools.com articles sourced from Content Collections.
 * Wraps BaseLayout with article-specific head metadata, OG tags, canonical URL,
 * breadcrumb, and a <slot /> for the article body.
 *
 * Usage (from a [slug].astro page):
 *   import ArticleLayout from '../../layouts/ArticleLayout.astro';
 *   const { entry } = Astro.props;
 *   const { Content } = await entry.render();
 *   <ArticleLayout {...entry.data} slug={entry.slug}>
 *     <Content />
 *   </ArticleLayout>
 */

import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  date: Date;
  category: 'security-news' | 'bug-bounty' | 'tools' | 'research';
  tags?: string[];
  slug?: string;
  /** Set true when the article contains a FAQ section — injects FAQPage schema */
  hasFAQ?: boolean;
  /** Tool review data — injects ItemList/SoftwareApplication/AggregateRating JSON-LD */
  toolReviews?: Array<{
    name: string;
    url: string;
    ratingValue: number;
    description?: string;
    price?: string;
    priceCurrency?: string;
  }>;
}

const { title, description, date, category, tags = [], slug, hasFAQ = false, toolReviews } = Astro.props;

const isoDate = date instanceof Date ? date.toISOString() : new Date(date).toISOString();
// Human-readable date
const displayDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Canonical URL for this article
const articleUrl = `https://bughuntertools.com/articles/${slug ?? ''}/`;

// Reading time estimate (rough: 200 wpm)
// We don't have word count here, so omit or let parent override if needed.

// Category display names
const categoryLabels: Record<string, string> = {
  'security-news':  'Security News',
  'bug-bounty':     'Bug Bounty',
  'tools':          'Tools',
  'research':       'Research',
};
const categoryLabel = categoryLabels[category] ?? category;
---

<BaseLayout
  title={title}
  description={description}
  schemaType="Article"
  isArticle={true}
  articleTitle={title}
>
  <!-- Article-specific structured data (overwrites BaseLayout's generic schema) -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "url": articleUrl,
      "datePublished": isoDate,
      "dateModified": isoDate,
      "author": {
        "@type": "Organization",
        "name": "BugHunterTools",
        "url": "https://bughuntertools.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "BugHunterTools",
        "url": "https://bughuntertools.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://bughuntertools.com/android-chrome-256x256.png"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": articleUrl
      }
    })}
    slot="head-extra"
  />

  <!-- FAQPage structured data (when hasFAQ=true) -->
  {hasFAQ && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "url": articleUrl,
        "name": title,
        "description": description,
        "mainEntity": []
      })}
      slot="head-extra"
    />
  )}

  <!-- Product/SoftwareApplication + AggregateRating structured data (when toolReviews present) -->
  {toolReviews && toolReviews.length > 0 && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": title,
        "url": articleUrl,
        "description": description,
        "itemListElement": toolReviews.map((tool, index) => ({
          "@type": "ListItem",
          "position": index + 1,
          "item": {
            "@type": "SoftwareApplication",
            "name": tool.name,
            "url": tool.url,
            "applicationCategory": "SecurityApplication",
            ...(tool.price ? {
              "offers": {
                "@type": "Offer",
                "price": tool.price,
                "priceCurrency": tool.priceCurrency ?? "USD"
              }
            } : {}),
            "aggregateRating": {
              "@type": "AggregateRating",
              "ratingValue": String(tool.ratingValue),
              "bestRating": "5",
              "worstRating": "1",
              "reviewCount": "1"
            },
            "review": {
              "@type": "Review",
              "reviewRating": {
                "@type": "Rating",
                "ratingValue": String(tool.ratingValue),
                "bestRating": "5"
              },
              "author": {
                "@type": "Organization",
                "name": "BugHunterTools",
                "url": "https://bughuntertools.com"
              },
              ...(tool.description ? { "reviewBody": tool.description } : {})
            }
          }
        }))
      })}
      slot="head-extra"
    />
  )}

  <article class="article-content">
    <!-- Article header -->
    <header class="article-header">
      <div class="article-meta">
        <span class="category-badge">{categoryLabel}</span>
        <time datetime={isoDate}>{displayDate}</time>
      </div>
      <h1>{title}</h1>
      <p class="article-description">{description}</p>
      {tags.length > 0 && (
        <div class="article-tags" aria-label="Tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>

    <!-- Article body -->
    <div class="article-body">
      <slot />
    </div>

    <!-- Google AdSense — below article -->
    <div class="ad-container ad-below-article">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-9373816755142401"
           data-ad-slot="9879569728"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
  </article>
</BaseLayout>

<style>
  .article-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .article-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
    color: #475569;
  }

  .category-badge {
    background: #2563eb;
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .article-header h1 {
    font-size: 2rem;
    line-height: 1.25;
    margin: 0.5rem 0 1rem;
    color: #1e293b;
  }

  .article-description {
    font-size: 1.1rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background: #f1f5f9;
    color: #475569;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-size: 0.8rem;
  }

  .article-body {
    line-height: 1.7;
    color: #334155;
  }

  .article-body h2 {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
    color: #1e293b;
  }

  .article-body h3 {
    font-size: 1.25rem;
    margin: 1.5rem 0 0.75rem;
    color: #1e293b;
  }

  .article-body p {
    margin-bottom: 1rem;
  }

  .article-body ul,
  .article-body ol {
    margin: 1rem 0 1rem 1.5rem;
  }

  .article-body li {
    margin-bottom: 0.4rem;
  }

  .article-body code {
    background: #f1f5f9;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .article-body pre {
    background: #1e293b;
    color: #e2e8f0;
    padding: 1rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .article-body pre code {
    background: none;
    padding: 0;
    color: inherit;
  }

  .article-body blockquote {
    border-left: 4px solid #2563eb;
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: #475569;
    font-style: italic;
  }

  @media (max-width: 640px) {
    .article-content {
      padding: 1rem 0;
    }

    .article-header h1 {
      font-size: 1.5rem;
    }
  }
</style>
